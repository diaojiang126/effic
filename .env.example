# 设备库存管理系统 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改（真实凭据不要提交到 Git）

# ============================================
# 数据库配置
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_DATABASE=device_inventory_system

# ============================================
# 安全配置（生产环境必须改为随机值）
# ============================================

# Flask Session 密钥（用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
SECRET_KEY=change-me-generate-a-random-value
# JWT 密钥（同样随机生成）
JWT_SECRET_KEY=change-me-generate-a-random-value

# ITS 密码加密密钥（运行 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
ITS_SECRET_KEY=change-me-generate-a-random-value

# ============================================
# 快递单 OCR（百度智能云，可选）
# 留空则自动使用本地 Tesseract
# ============================================
BAIDU_AIP_APP_ID=
BAIDU_AIP_API_KEY=
BAIDU_AIP_SECRET_KEY=

# ============================================
# 服务器配置
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5050

# ============================================
# 可选配置
# ============================================

# CORS 允许的来源（逗号分隔，生产环境改为实际域名）
# CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# IIS FastCGI: web.config的<appSettings>也会自动注入到环境变量
# 如果通过IIS部署，数据库/JWT配置也可以在web.config中设置
# .env和web.config同时配置时，.env优先级更高(override=False)
