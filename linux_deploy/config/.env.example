# 设备库存管理系统 - Linux/Ubuntu 环境变量示例
# 部署时复制为 /opt/effic/.env 并修改

# ============================================
# 数据库配置
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ls
DB_PASSWORD=ls1213456
DB_DATABASE=device_inventory_system

# ============================================
# 安全配置（生产环境必须重新生成）
# python3 -c "import secrets; print(secrets.token_hex(32))"
# ============================================
SECRET_KEY=change_me_generate_64_hex
JWT_SECRET_KEY=change_me_generate_64_hex

# ============================================
# ITS 密码加密（companies.its_password 敏感字段）
# 必须与 Windows 旧环境 web.config 里 appSettings 的 ITS_SECRET_KEY 完全一致，
# 否则历史 enc: 密文无法解密，APP「选择 ITS 工单」会报
#   ITS 密码解密失败: 未配置 ITS_SECRET_KEY，无法解密敏感字段
# 仅全新部署（无历史密文）时才可新生成：
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 支持逗号分隔多把：第一把用于加密，全部用于解密（便于轮换）
# ============================================
# ITS_SECRET_KEY=

# ============================================
# 服务器配置
# ============================================
FLASK_ENV=production
FLASK_DEBUG=False
HOST=127.0.0.1
PORT=5050

# ============================================
# Tesseract OCR（Linux 下由 apt 安装，通常在 /usr/bin/tesseract）
# 若位置不同，可显式指定
# ============================================
# TESSERACT_CMD=/usr/bin/tesseract

# ============================================
# 快递单 OCR（百度智能云，可选）
# ============================================
BAIDU_AIP_APP_ID=
BAIDU_AIP_API_KEY=
BAIDU_AIP_SECRET_KEY=

# ============================================
# CORS（可选）
# ============================================
# CORS_ALLOWED_ORIGINS=https://your-domain.com
