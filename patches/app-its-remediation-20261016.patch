+    def close(self):
+        """关闭底层 HTTP 会话，释放连接池占用的套接字。
+
+        requests.Session 会保持 keep-alive 连接，若每次请求都新建而不关闭，
+        长期运行会累积套接字（生产环境曾因此类资源累积触发过套接字资源耗尽），
+        故每次用完必须显式调用 close()。
+        """
+        try:
+            self._session.close()
+        except Exception:
+            pass
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
