diff --git a/crypto_util.py b/crypto_util.py
new file mode 100644
index 0000000..08e94a5
--- /dev/null
+++ b/crypto_util.py
@@ -0,0 +1,64 @@
+"""敏感字段加密工具（用于 companies.its_password 等）
+
+设计要点：
+1. 对称加密（Fernet = AES-128-CBC + HMAC-SHA256），因 ITS 登录需要明文，不能使用哈希；
+2. 密文统一带前缀 ``enc:``，与历史明文共存，便于平滑迁移与回滚；
+3. 密钥只从环境变量 ``ITS_SECRET_KEY`` 读取，绝不写入代码或数据库；
+   支持逗号分隔多把密钥：**第一把用于加密，全部用于解密**（便于密钥轮换）；
+4. 未配置密钥时：解密（兼容明文）可正常工作，加密会抛错，避免敏感字段被静默明文落库。
+
+环境变量配置（IIS 下写在 web.config 的 appSettings 中优先生效）：
+    ITS_SECRET_KEY=<Fernet.generate_key() 生成的 44 位 base64 字符串>
+生成方式：
+    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
+"""
+
+import os
+
+ENC_PREFIX = 'enc:'          # 密文前缀：用于区分密文与历史明文
+PLACEHOLDER = '******'       # 前端回显用的脱敏占位符（提交该值表示“不修改密码”）
+
+_fernets = []
+try:
+    from cryptography.fernet import Fernet, InvalidToken  # noqa: F401
+    for _raw in (os.environ.get('ITS_SECRET_KEY') or '').split(','):
+        _key = _raw.strip()
+        if not _key:
+            continue
+        try:
+            _fernets.append(Fernet(_key.encode()))
+        except Exception as e:
+            print(f"[WARN] ITS_SECRET_KEY 无效，已跳过: {e}")
+except ImportError as e:
+    print(f"[WARN] 未安装 cryptography，敏感字段加密不可用: {e}")
+
+
+def is_enabled():
+    """是否已配置可用的加密密钥"""
+    return len(_fernets) > 0
+
+
+def encrypt_secret(plain):
+    """明文 -> 'enc:<token>'；空值原样返回；未配置密钥时抛错（拒绝明文落库）"""
+    if not plain:
+        return plain or ''
+    if not is_enabled():
+        raise RuntimeError('未配置 ITS_SECRET_KEY，拒绝以明文写入敏感字段')
+    return ENC_PREFIX + _fernets[0].encrypt(plain.encode('utf-8')).decode('ascii')
+
+
+def decrypt_secret(stored):
+    """'enc:<token>' -> 明文；无前缀（历史明文）原样返回；解密失败抛错"""
+    if not stored:
+        return ''
+    if not stored.startswith(ENC_PREFIX):
+        return stored                       # 兼容历史明文数据
+    if not is_enabled():
+        raise RuntimeError('未配置 ITS_SECRET_KEY，无法解密敏感字段')
+    token = stored[len(ENC_PREFIX):].encode('ascii')
+    for fernet in _fernets:
+        try:
+            return fernet.decrypt(token).decode('utf-8')
+        except Exception:
+            continue
+    raise RuntimeError('敏感字段解密失败：密钥不匹配（请检查 ITS_SECRET_KEY）')
diff --git a/migrate_its_password.py b/migrate_its_password.py
new file mode 100644
index 0000000..2ad7bff
--- /dev/null
+++ b/migrate_its_password.py
@@ -0,0 +1,99 @@
+"""its_password 明文 -> 密文 一次性迁移脚本（幂等，可重复执行）
+
+使用前置条件：
+    1) 已部署 crypto_util.py，并已在环境变量中配置 ITS_SECRET_KEY
+       （IIS 下为 web.config 的 appSettings；本地为 .env）；
+    2) 建议先用备份（脚本会自动建备份表）。
+
+执行：
+    cd C:\\luosen\\effic
+    C:\\Python312\\python.exe migrate_its_password.py
+
+行为：
+    - 自动创建备份表 companies_bak_<日期>（已存在则跳过）；
+    - 将 its_password 列长度扩到 VARCHAR(512)（Fernet 密文比明文长约 57 字符）；
+    - 仅对「非空且不带 enc: 前缀」的行加密，因此可反复执行而不会重复加密；
+    - 逐行打印结果，便于核对。
+"""
+
+import os
+import sys
+from datetime import datetime
+
+# 保证可 import 同目录下的模块
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import pymysql
+from dotenv import load_dotenv
+
+if not load_dotenv('.env', override=False):
+    load_dotenv(os.path.join(os.path.dirname(os.path.abspath(__file__)), '.env'), override=False)
+
+import crypto_util
+
+
+def main():
+    if not crypto_util.is_enabled():
+        print('[ABORT] 未配置 ITS_SECRET_KEY，请先配置密钥再执行迁移')
+        return 1
+
+    host = os.environ.get('DB_HOST', 'localhost')
+    user = os.environ.get('DB_USER')
+    password = os.environ.get('DB_PASSWORD')
+    database = os.environ.get('DB_DATABASE')
+    print(f'[INFO] 目标数据库: {host}/{database}')
+
+    conn = pymysql.connect(host=host, user=user, password=password,
+                           database=database, charset='utf8mb4', autocommit=False)
+    cur = conn.cursor(pymysql.cursors.DictCursor)
+    try:
+        # 1) 备份
+        bak = 'companies_bak_' + datetime.now().strftime('%Y%m%d')
+        cur.execute("SHOW TABLES LIKE %s", (bak,))
+        if cur.fetchone():
+            print(f'[SKIP] 备份表 {bak} 已存在，跳过备份')
+        else:
+            cur.execute(f"CREATE TABLE {bak} AS SELECT * FROM companies")
+            print(f'[OK] 已创建备份表 {bak}')
+
+        # 2) 扩列（Fernet 密文更长）
+        cur.execute("ALTER TABLE companies MODIFY its_password VARCHAR(512)")
+        print('[OK] its_password 列长度已调整为 VARCHAR(512)')
+
+        # 3) 逐行加密（仅处理无 enc: 前缀的行）
+        cur.execute("SELECT id, company_code, its_password FROM companies")
+        rows = cur.fetchall()
+        changed = 0
+        for row in rows:
+            raw = row.get('its_password') or ''
+            if not raw:
+                print(f'[SKIP] id={row["id"]} {row["company_code"]}: 密码为空')
+                continue
+            if raw.startswith(crypto_util.ENC_PREFIX):
+                print(f'[SKIP] id={row["id"]} {row["company_code"]}: 已是密文')
+                continue
+            cur.execute("UPDATE companies SET its_password = %s WHERE id = %s",
+                        (crypto_util.encrypt_secret(raw), row['id']))
+            changed += 1
+            print(f'[OK]   id={row["id"]} {row["company_code"]}: 已加密')
+
+        conn.commit()
+        print(f'[DONE] 迁移完成，共加密 {changed} 条记录')
+
+        # 4) 校验
+        cur.execute("SELECT id, company_code, LEFT(its_password,4) AS prefix FROM companies")
+        for r in cur.fetchall():
+            flag = 'OK ' if (r['prefix'] or '').startswith('enc') or not r['prefix'] else 'CHECK'
+            print(f'  [{flag}] id={r["id"]} {r["company_code"]} prefix={r["prefix"]!r}')
+    except Exception as e:
+        conn.rollback()
+        print(f'[FAIL] 迁移失败，已回滚: {e}')
+        return 1
+    finally:
+        cur.close()
+        conn.close()
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
